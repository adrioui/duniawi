# shell:
  cd /run/media/adrioui/backup/home || exit 1
  set +e
  acl=/tmp/duniawi-acl-$(date +%Y%m%dT%H%M%S).txt
  xattr=/tmp/duniawi-xattr-$(date +%Y%m%dT%H%M%S).txt
  cap=/tmp/duniawi-cap-$(date +%Y%m%dT%H%M%S).txt
  getfacl -R -p . > "$acl" 2>/tmp/duniawi-acl.err
  sha256sum "$acl"
  echo "acl_lines=$(wc -l < "$acl")"
  getfattr -R -d -m - . > "$xattr" 2>/tmp/duniawi-xattr.err
  sha256sum "$xattr"
  echo "xattr_lines=$(wc -l < "$xattr")"
  getcap -r . 2>/tmp/duniawi-cap.err | LC_ALL=C sort > "$cap"
  sha256sum "$cap"
  echo "cap_lines=$(wc -l < "$cap")"
  echo "--- stderr sizes ---"
  wc -l /tmp/duniawi-acl.err /tmp/duniawi-xattr.err /tmp/duniawi-cap.err 2>/dev/null || true

